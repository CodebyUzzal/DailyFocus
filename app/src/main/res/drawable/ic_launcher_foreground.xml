<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        DailyFocus Premium Icon — Foreground Layer
        Concept: Bold geometric "D" monogram with integrated focus dot.
        The "D" represents DailyFocus brand identity.
        The dot inside the bowl represents the single focus point — 
        the one thing to execute today.

        Canvas: 108x108dp
        Safe zone: 18dp inset on each side (content from 18-90)
        Actual content: centered with comfortable padding (~28-80)

        Color palette:
        - Primary mark: White (#FFFFFF)
        - Focus dot: Soft teal accent (#80CBC4)
    -->

    <!-- Bold geometric "D" monogram -->
    <path
        android:pathData="
            M 38,30
            Q 34,30 34,34
            L 34,74
            Q 34,78 38,78
            L 48,78
            C 62.5,78 74,67.5 74,54
            C 74,40.5 62.5,30 48,30
            Z
            M 44,38
            L 44,70
            L 48,70
            C 57.5,70 64,63 64,54
            C 64,45 57.5,38 48,38
            Z"
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd" />

    <!-- Focus dot — teal accent in upper-right of bowl interior -->
    <path
        android:pathData="M 56,50 m -3.5,0 a 3.5,3.5 0 1,1 7,0 a 3.5,3.5 0 1,1 -7,0"
        android:fillColor="#80CBC4" />
</vector>